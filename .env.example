# ==========================================
# नयाँदृष्टि (NayaDristi) Environment Variables
# ==========================================

# Application Port (Default: 3000)
PORT=3000

# Base Application URL
APP_URL="http://localhost:3000"

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# Option A: Single Connection String (Recommended for Supabase, Neon, Render, Railway)
DATABASE_URL="postgres://postgres:password@localhost:5432/nayadristi"

# Option B: Individual Parameters (Used by Cloud SQL / standard hosts)
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="your_db_password"
SQL_DB_NAME="nayadristi"

# ------------------------------------------
# Firebase Configuration (Optional for Google Auth)
# ------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
