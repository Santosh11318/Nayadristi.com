{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A news article published on the portal",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Headline of the article" },
        "slug": { "type": "string", "description": "Unique URL slug" },
        "summary": { "type": "string", "description": "Brief summary or lead paragraph" },
        "content": { "type": "string", "description": "Full HTML or markdown news content" },
        "featuredImageUrl": { "type": "string", "description": "Cover image URL" },
        "imageCaption": { "type": "string", "description": "Image caption or source credits" },
        "categoryId": { "type": "string", "description": "Associated category ID or slug" },
        "categoryName": { "type": "string", "description": "Category display name" },
        "authorId": { "type": "string", "description": "Author or journalist ID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"], "description": "Publish status" },
        "isFeatured": { "type": "boolean", "description": "Whether to display as lead hero story" },
        "isBreaking": { "type": "boolean", "description": "Whether to display in breaking ticker" },
        "views": { "type": "number", "description": "Article view count" },
        "publishedAt": { "type": "string", "format": "date-time", "description": "Publication timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["title", "slug", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "A news classification category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name in Nepali" },
        "slug": { "type": "string", "description": "Category slug in English" },
        "description": { "type": "string", "description": "Category description" },
        "sortOrder": { "type": "number", "description": "Display order" }
      },
      "required": ["name", "slug"]
    },
    "Author": {
      "title": "Author",
      "description": "A journalist or editor profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Author full name" },
        "designation": { "type": "string", "description": "Author role or designation" },
        "bio": { "type": "string", "description": "Short bio" },
        "photoUrl": { "type": "string", "description": "Avatar image URL" }
      },
      "required": ["name"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "A banner advertisement",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Ad title or client name" },
        "position": { "type": "string", "description": "Placement identifier" },
        "imageUrl": { "type": "string", "description": "Banner graphic image URL" },
        "adUrl": { "type": "string", "description": "Target destination URL" },
        "isActive": { "type": "boolean", "description": "Whether the ad is currently active" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["title", "position", "imageUrl"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Reader comment on an article",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "description": "Associated article ID" },
        "articleSlug": { "type": "string", "description": "Associated article slug" },
        "name": { "type": "string", "description": "Reader full name" },
        "email": { "type": "string", "description": "Reader email address" },
        "content": { "type": "string", "description": "Comment content text" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"], "description": "Moderation status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["articleId", "name", "content"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Portal global settings",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Setting key identifier" },
        "value": { "type": "string", "description": "Setting value or JSON payload" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Updated timestamp" }
      },
      "required": ["key"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Published and draft news articles"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "News classification categories"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Journalists, correspondents, and editors"
    },
    "/advertisements/{adId}": {
      "schema": "Advertisement",
      "description": "Commercial ad banners across the portal"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Public comments on news articles"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Portal configurations and settings"
    }
  }
}
